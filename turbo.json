{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^test"
      ],
      "cache": false
    },
    "e2e": {
      "cache": false,
      "passThroughEnv": [
        "CI",
        "E2E_DEV"
      ]
    },
    "mobile#e2e": {
      "cache": false,
      "passThroughEnv": [
        "CI",
        "E2E_DEV"
      ],
      "dependsOn": [
        "web#e2e"
      ]
    }
  }
}
